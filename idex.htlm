<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#1e1b4b">
<title>找单词 · Word Search</title>
<style>
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

  html, body {
    margin: 0; padding: 0; min-height: 100%;
    overscroll-behavior: none;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
                 'Hiragino Sans GB', 'Microsoft YaHei', system-ui, sans-serif;
    background: linear-gradient(160deg, #1e1b4b 0%, #312e81 45%, #4c1d95 100%);
    background-attachment: fixed;
    color: #e2e8f0;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    justify-content: center;
    padding: 10px 10px calc(10px + env(safe-area-inset-bottom));
    overflow-x: hidden;
  }

  body::before {
    content: '';
    position: fixed; width: 620px; height: 620px;
    background: radial-gradient(circle, rgba(139,92,246,.35), transparent 70%);
    top: -240px; left: -220px; pointer-events: none; z-index: 0;
  }
  body::after {
    content: '';
    position: fixed; width: 520px; height: 520px;
    background: radial-gradient(circle, rgba(56,189,248,.22), transparent 70%);
    bottom: -220px; right: -180px; pointer-events: none; z-index: 0;
  }

  .app {
    position: relative; z-index: 1;
    width: 100%; max-width: 560px;
    display: flex; flex-direction: column; gap: 10px;
  }

  /* ---------- Header ---------- */
  header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 2px 4px;
  }
  h1 {
    margin: 0; font-size: 1.3rem; font-weight: 800; letter-spacing: 1px;
    background: linear-gradient(90deg, #a78bfa, #38bdf8 50%, #34d399);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .audio-controls { display: flex; gap: 8px; }
  .icon-btn {
    width: 40px; height: 40px; border-radius: 13px;
    border: 1px solid rgba(255,255,255,.16);
    background: rgba(255,255,255,.08);
    color: #fff; font-size: 17px; cursor: pointer;
    display: grid; place-items: center;
    transition: transform .18s, background .18s, opacity .18s;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .icon-btn:hover { background: rgba(255,255,255,.18); transform: translateY(-1px); }
  .icon-btn:active { transform: scale(.94); }
  .icon-btn.off { opacity: .38; }

  /* ---------- HUD ---------- */
  .hud { display: flex; gap: 8px; }
  .hud-item {
    flex: 1; text-align: center; padding: 7px 4px 8px;
    background: rgba(255,255,255,.07);
    border: 1px solid rgba(255,255,255,.11);
    border-radius: 14px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: border-color .3s, background .3s;
  }
  .hud-item .label {
    display: block; font-size: .66rem; letter-spacing: 1.5px;
    opacity: .6; margin-bottom: 1px;
  }
  .hud-item .value {
    font-size: 1.02rem; font-weight: 800;
    font-variant-numeric: tabular-nums; letter-spacing: .5px;
  }
  .hud-item.warn { border-color: rgba(251,113,133,.6); background: rgba(244,63,94,.14); }
  .hud-item.warn .value { color: #fb7185; animation: pulse .85s ease-in-out infinite; }
  @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: .45; } }

  /* ---------- Word chips ---------- */
  .words {
    display: flex; flex-wrap: wrap; gap: 7px; justify-content: center;
    min-height: 32px; padding: 0 2px;
  }
  .word-chip {
    --c: #94a3b8;
    padding: 5px 13px; border-radius: 999px;
    font-size: .86rem; font-weight: 700; letter-spacing: .4px;
    background: rgba(255,255,255,.07);
    border: 1.5px solid var(--c);
    color: #e2e8f0;
    transition: background .3s, color .3s, transform .3s, box-shadow .3s;
    animation: chipIn .35s cubic-bezier(.2,.9,.3,1.4) backwards;
  }
  @keyframes chipIn { from { opacity: 0; transform: scale(.6); } }
  .word-chip.found {
    background: var(--c); color: #fff; border-color: var(--c);
    text-decoration: line-through;
    text-decoration-thickness: 2px;
    transform: scale(.95);
    box-shadow: 0 6px 18px -6px var(--c);
  }

  /* ---------- Board ---------- */
  .board-wrap { display: flex; justify-content: center; }

  .board {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 4px;
    width: min(100%, 480px);
    padding: 10px;
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 20px;
    box-shadow: 0 24px 60px -26px rgba(0,0,0,.9), inset 0 1px 0 rgba(255,255,255,.08);
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .cell {
    aspect-ratio: 1 / 1;
    display: flex; align-items: center; justify-content: center;
    background: rgba(255,255,255,.93);
    color: #1e1b4b;
    border-radius: 8px;
    font-weight: 800;
    font-size: clamp(11px, 3.4vw, 18px);
    text-transform: lowercase;
    cursor: pointer;
    transition: background .13s, color .13s, transform .13s, box-shadow .2s;
    will-change: transform;
    overflow: hidden;
  }
  .cell.sel {
    background: #818cf8 !important;
    color: #fff !important;
    transform: scale(1.07);
    box-shadow: 0 4px 14px -3px rgba(129,140,248,.9);
    z-index: 2;
  }
  .cell.found {
    color: #fff !important;
    text-shadow: 0 1px 2px rgba(0,0,0,.35);
    animation: pop .3s cubic-bezier(.2,.9,.3,1.6);
  }
  @keyframes pop {
    0% { transform: scale(.82); }
    60% { transform: scale(1.1); }
    100% { transform: scale(1); }
  }
  .cell.missed {
    box-shadow: inset 0 0 0 2.5px var(--miss, #ef4444);
  }
  @media (max-width: 380px) {
    .board { gap: 3px; padding: 8px; border-radius: 16px; }
    .cell { border-radius: 6px; }
  }

  .tip {
    text-align: center; font-size: .76rem; opacity: .45;
    margin: 0; letter-spacing: .5px;
  }

  /* ---------- Overlay ---------- */
  .overlay {
    position: fixed; inset: 0; z-index: 60;
    display: flex; align-items: center; justify-content: center;
    padding: 18px;
    background: rgba(9, 7, 26, .74);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    opacity: 0; pointer-events: none;
    transition: opacity .28s ease;
  }
  .overlay.show { opacity: 1; pointer-events: auto; }

  .card {
    width: 100%; max-width: 400px;
    background: linear-gradient(160deg, #221e56, #2e1065 70%, #1e1b4b);
    border: 1px solid rgba(255,255,255,.14);
    border-radius: 26px;
    padding: 26px 22px 22px;
    text-align: center;
    box-shadow: 0 34px 90px -24px #000, inset 0 1px 0 rgba(255,255,255,.1);
    transform: translateY(18px) scale(.96);
    transition: transform .38s cubic-bezier(.2,.9,.3,1.25);
    max-height: 92vh; overflow-y: auto;
  }
  .overlay.show .card { transform: none; }

  .logo {
    font-size: 2.6rem; line-height: 1;
    animation: float 3s ease-in-out infinite;
    margin-bottom: 6px;
  }
  @keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }

  .card h2 {
    margin: 4px 0 8px; font-size: 1.45rem; font-weight: 800; letter-spacing: 1px;
    background: linear-gradient(90deg,#c4b5fd,#67e8f9);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .sub {
    margin: 0 0 18px; font-size: .82rem; line-height: 1.65;
    opacity: .62;
  }

  .input {
    width: 100%; padding: 14px 16px; border-radius: 14px;
    border: 1.5px solid rgba(255,255,255,.16);
    background: rgba(0,0,0,.32);
    color: #fff; font-size: 1rem; font-weight: 600;
    text-align: center; letter-spacing: 1px;
    outline: none; transition: border-color .2s, box-shadow .2s;
    font-family: inherit;
  }
  .input::placeholder { color: rgba(255,255,255,.28); font-weight: 500; letter-spacing: .5px; }
  .input:focus {
    border-color: #818cf8;
    box-shadow: 0 0 0 3.5px rgba(129,140,248,.22);
  }

  .err {
    min-height: 18px; font-size: .76rem; color: #fb7185;
    margin: 7px 0 4px; letter-spacing: .3px;
  }

  .btn {
    width: 100%; padding: 14px; border-radius: 14px; border: none;
    cursor: pointer; font-family: inherit;
    font-size: 1.02rem; font-weight: 800; letter-spacing: 2.5px;
    color: #fff;
    background: linear-gradient(135deg, #8b5cf6, #6366f1);
    box-shadow: 0 12px 28px -10px #6366f1;
    transition: transform .18s, box-shadow .18s, filter .18s;
  }
  .btn:hover { transform: translateY(-2px); box-shadow: 0 16px 34px -10px #6366f1; filter: brightness(1.08); }
  .btn:active { transform: translateY(0) scale(.985); }

  .score-big {
    font-size: 3.6rem; font-weight: 900; line-height: 1;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(180deg, #fde68a, #f59e0b);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    margin: 6px 0 0;
    filter: drop-shadow(0 6px 16px rgba(245,158,11,.35));
  }
  .score-label { font-size: .78rem; opacity: .5; letter-spacing: 3px; margin-bottom: 16px; }

  .stats {
    display: flex; gap: 8px; margin-bottom: 18px;
  }
  .stat {
    flex: 1; padding: 10px 4px;
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 13px;
  }
  .stat span { display: block; font-size: .68rem; opacity: .55; letter-spacing: 1px; margin-bottom: 3px; }
  .stat b { font-size: 1.02rem; font-variant-numeric: tabular-nums; }

  /* ---------- Toast ---------- */
  .toast {
    position: fixed; left: 50%; bottom: 28px; z-index: 200;
    transform: translate(-50%, 18px);
    background: rgba(15,23,42,.96);
    border: 1px solid rgba(255,255,255,.15);
    color: #fff; font-size: .85rem; font-weight: 600;
    padding: 11px 20px; border-radius: 13px;
    opacity: 0; pointer-events: none;
    transition: opacity .28s, transform .28s;
    box-shadow: 0 16px 40px -12px #000;
    max-width: 88vw; text-align: center;
  }
  .toast.show { opacity: 1; transform: translate(-50%, 0); }
</style>
</head>
<body>

<div class="app">
  <header>
    <h1>🔍 找单词</h1>
    <div class="audio-controls">
      <button class="icon-btn" id="musicBtn" title="背景音乐" aria-label="背景音乐开关">🎵</button>
      <button class="icon-btn" id="sfxBtn" title="音效" aria-label="音效开关">🔊</button>
    </div>
  </header>

  <div class="hud">
    <div class="hud-item">
      <span class="label">用时</span>
      <span class="value" id="timerVal">00:00</span>
    </div>
    <div class="hud-item">
      <span class="label">进度</span>
      <span class="value" id="progressVal">0/0</span>
    </div>
    <div class="hud-item" id="remainItem">
      <span class="label">剩余</span>
      <span class="value" id="remainVal">--:--</span>
    </div>
  </div>

  <div class="words" id="wordList"></div>

  <div class="board-wrap">
    <div class="board" id="board"></div>
  </div>

  <p class="tip">按住字母横向或纵向滑动，拼出单词 ✏️</p>
</div>

<!-- 开始界面 -->
<div class="overlay show" id="startOverlay">
  <div class="card">
    <div class="logo">🔤</div>
    <h2>找单词</h2>
    <p class="sub">
      输入最多 10 个英文单词（用空格分隔）<br>
      留空则从 100 个儿童单词中随机抽取 5–10 个
    </p>
    <input class="input" id="startInput" type="text"
           placeholder="例如：cat dog sun" autocomplete="off"
           autocapitalize="none" autocorrect="off" spellcheck="false">
    <div class="err" id="startError"></div>
    <button class="btn" id="startBtn">开 始 游 戏</button>
  </div>
</div>

<!-- 结束界面 -->
<div class="overlay" id="endOverlay">
  <div class="card">
    <div class="logo" id="endEmoji">🎉</div>
    <h2 id="endTitle">全部找到！</h2>
    <div class="score-big" id="endScore">0</div>
    <div class="score-label">得分</div>
    <div class="stats">
      <div class="stat"><span>用时</span><b id="statTime">00:00</b></div>
      <div class="stat"><span>单词</span><b id="statWords">0</b></div>
      <div class="stat"><span>找到</span><b id="statFound">0</b></div>
    </div>
    <button class="btn" id="restartBtn">再 玩 一 次</button>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
(function () {
  'use strict';

  /* ============================================================
     1. 基础数据
     ============================================================ */
  const SIZE = 10;

  const WORD_POOL = [
    'cat','dog','sun','hat','bat','rat','mat','sit','run','fun',
    'big','red','blue','green','apple','banana','tree','fish','bird','milk',
    'cake','book','ball','star','moon','rain','snow','wind','fire','hand',
    'foot','eye','ear','nose','mouth','hair','head','face','arm','leg',
    'cup','pen','box','key','map','bag','bed','door','wall','floor',
    'roof','car','bus','train','boat','plane','bike','road','park','home',
    'school','teacher','friend','happy','sad','fast','slow','hot','cold','warm',
    'cool','jump','walk','swim','sing','dance','play','read','write','draw',
    'eat','drink','sleep','smile','laugh','cry','pink','black','white','brown',
    'orange','yellow','purple','tiger','lion','bear','duck','frog','cow','pig'
  ];

  const COLORS = [
    '#dc2626', '#ea580c', '#ca8a04', '#16a34a', '#0d9488',
    '#2563eb', '#7c3aed', '#db2777', '#65a30d', '#0891b2'
  ];

  /* ============================================================
     2. 8-bit 音频引擎（Web Audio API）
     ============================================================ */
  const GameAudio = (function () {
    let ctx = null;
    let master = null, musicBus = null, sfxBus = null;
    let musicOn = true, sfxOn = true;
    let seqTimer = null, nextTime = 0, stepIdx = 0;

    // 32 步循环旋律（MIDI 音高，0 = 休止）
    const MELODY = [
      72, 76, 79, 76, 69, 72, 76, 72,
      65, 69, 72, 69, 67, 71, 74, 71,
      72, 76, 79, 84, 79, 76, 72, 76,
      74, 71, 67, 71, 72, 0,  72, 0
    ];
    const BASS = [
      48, 0, 0, 0, 45, 0, 0, 0, 41, 0, 0, 0, 43, 0, 0, 0,
      48, 0, 0, 0, 45, 0, 0, 0, 43, 0, 0, 0, 48, 0, 0, 0
    ];
    const STEP = 0.155;

    const mtof = (m) => 440 * Math.pow(2, (m - 69) / 12);

    function init() {
      if (ctx) return;
      const AC = window.AudioContext || window.webkitAudioContext;
      if (!AC) return;
      try {
        ctx = new AC();
      } catch (e) { return; }
      master = ctx.createGain();
      master.gain.value = 0.9;
      master.connect(ctx.destination);

      musicBus = ctx.createGain();
      musicBus.gain.value = 0.55;
      musicBus.connect(master);

      sfxBus = ctx.createGain();
      sfxBus.gain.value = 0.7;
      sfxBus.connect(master);
    }

    function resume() {
      if (ctx && ctx.state === 'suspended') ctx.resume();
    }

    function tone(freq, when, dur, type, vol, bus) {
      if (!ctx) return;
      const t = Math.max(when, ctx.currentTime + 0.001);
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = type || 'square';
      osc.frequency.setValueAtTime(freq, t);
      gain.gain.setValueAtTime(0.0001, t);
      gain.gain.exponentialRampToValueAtTime(Math.max(vol, 0.0002), t + 0.012);
      gain.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      osc.connect(gain);
      gain.connect(bus);
      osc.start(t);
      osc.stop(t + dur + 0.03);
    }

    /* ---------- 音效 ---------- */
    function click() {
      if (!ctx || !sfxOn) return;
      tone(1046.5, ctx.currentTime, 0.05, 'square', 0.10, sfxBus);
    }

    function match() {
      if (!ctx || !sfxOn) return;
      const t0 = ctx.currentTime;
      [523.25, 659.25, 783.99, 1046.5].forEach(function (f, i) {
        tone(f, t0 + i * 0.07, 0.17, 'square', 0.13, sfxBus);
        tone(f * 2, t0 + i * 0.07, 0.11, 'triangle', 0.045, sfxBus);
      });
    }

    function fail() {
      if (!ctx || !sfxOn) return;
      const t0 = ctx.currentTime;
      tone(196, t0, 0.10, 'sawtooth', 0.075, sfxBus);
      tone(147, t0 + 0.075, 0.14, 'sawtooth', 0.075, sfxBus);
    }

    function tick(urgent) {
      if (!ctx || !sfxOn) return;
      tone(urgent ? 1245 : 880, ctx.currentTime, 0.055, 'square', 0.085, sfxBus);
    }

    function gameOver(win) {
      if (!ctx || !sfxOn) return;
      const t0 = ctx.currentTime;
      const notes = win
        ? [523.25, 659.25, 783.99, 1046.5, 783.99, 1046.5, 1318.5]
        : [523.25, 466.16, 392.00, 311.13];
      const d = win ? 0.13 : 0.2;
      notes.forEach(function (f, i) {
        tone(f, t0 + i * d, d * 1.25, 'square', 0.14, sfxBus);
      });
      if (win) tone(261.63, t0, 0.95, 'triangle', 0.10, sfxBus);
    }

    /* ---------- 背景音乐 ---------- */
    function schedule() {
      if (!ctx) return;
      const horizon = ctx.currentTime + 0.3;
      while (nextTime < horizon) {
        const m = MELODY[stepIdx % MELODY.length];
        if (m) tone(mtof(m), nextTime, STEP * 0.85, 'square', 0.075, musicBus);
        const b = BASS[stepIdx % BASS.length];
        if (b) tone(mtof(b), nextTime, STEP * 1.7, 'triangle', 0.15, musicBus);
        nextTime += STEP;
        stepIdx++;
      }
    }

    function startMusic() {
      if (!ctx || !musicOn || seqTimer) return;
      nextTime = ctx.currentTime + 0.08;
      stepIdx = 0;
      seqTimer = setInterval(schedule, 60);
    }

    function stopMusic() {
      if (seqTimer) { clearInterval(seqTimer); seqTimer = null; }
    }

    function toggleMusic() {
      musicOn = !musicOn;
      if (musicOn) { init(); resume(); startMusic(); }
      else stopMusic();
      return musicOn;
    }

    function toggleSfx() {
      sfxOn = !sfxOn;
      return sfxOn;
    }

    return {
      init: init, resume: resume,
      click: click, match: match, fail: fail, tick: tick, gameOver: gameOver,
      startMusic: startMusic, stopMusic: stopMusic,
      toggleMusic: toggleMusic, toggleSfx: toggleSfx
    };
  })();

  /* ============================================================
     3. DOM 引用
     ============================================================ */
  const boardEl     = document.getElementById('board');
  const wordListEl  = document.getElementById('wordList');
  const timerVal    = document.getElementById('timerVal');
  const progressVal = document.getElementById('progressVal');
  const remainVal   = document.getElementById('remainVal');
  const remainItem  = document.getElementById('remainItem');

  const startOverlay = document.getElementById('startOverlay');
  const endOverlay   = document.getElementById('endOverlay');
  const startInput   = document.getElementById('startInput');
  const startError   = document.getElementById('startError');
  const startBtn     = document.getElementById('startBtn');
  const restartBtn   = document.getElementById('restartBtn');

  const endEmoji = document.getElementById('endEmoji');
  const endTitle = document.getElementById('endTitle');
  const endScore = document.getElementById('endScore');
  const statTime = document.getElementById('statTime');
  const statWords = document.getElementById('statWords');
  const statFound = document.getElementById('statFound');

  const musicBtn = document.getElementById('musicBtn');
  const sfxBtn   = document.getElementById('sfxBtn');
  const toastEl  = document.getElementById('toast');

  /* ============================================================
     4. 游戏状态
     ============================================================ */
  const state = {
    words: [],
    found: [],
    grid: [],
    placed: {},
    colors: {},
    running: false,
    startTime: 0,
    elapsed: 0,
    timeLimit: 0,
    timerId: null,
    selStart: null,
    selCells: [],
    activePointer: null,
    lastTickSec: -1,
    lastInput: ''
  };

  const cellAt = (r, c) => boardEl.children[r * SIZE + c];

  /* ============================================================
     5. 工具函数
     ============================================================ */
  function fmtTime(sec) {
    sec = Math.max(0, Math.floor(sec));
    const m = Math.floor(sec / 60);
    const s = sec % 60;
    return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
  }

  function randLetter() {
    return String.fromCharCode(97 + Math.floor(Math.random() * 26));
  }

  let toastTimer = null;
  function toast(msg) {
    toastEl.textContent = msg;
    toastEl.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toastEl.classList.remove('show'), 2200);
  }

  /* ============================================================
     6. 谜题生成 + 校验
     ============================================================ */
  function canPlace(grid, word, r, c, dr, dc) {
    const er = r + dr * (word.length - 1);
    const ec = c + dc * (word.length - 1);
    if (er >= SIZE || ec >= SIZE) return false;
    for (let i = 0; i < word.length; i++) {
      const ch = grid[r + dr * i][c + dc * i];
      if (ch && ch !== word[i]) return false;
    }
    return true;
  }

  function placeWord(grid, word) {
    const options = [];
    const dirs = [[0, 1], [1, 0]]; // 横向 / 纵向
    for (let d = 0; d < dirs.length; d++) {
      const dr = dirs[d][0], dc = dirs[d][1];
      for (let r = 0; r < SIZE; r++) {
        for (let c = 0; c < SIZE; c++) {
          if (canPlace(grid, word, r, c, dr, dc)) {
            options.push({ r: r, c: c, dr: dr, dc: dc });
          }
        }
      }
    }
    if (options.length === 0) return null;

    const p = options[Math.floor(Math.random() * options.length)];
    const cells = [];
    for (let i = 0; i < word.length; i++) {
      const rr = p.r + p.dr * i;
      const cc = p.c + p.dc * i;
      grid[rr][cc] = word[i];
      cells.push([rr, cc]);
    }
    return { r: p.r, c: p.c, dr: p.dr, dc: p.dc, cells: cells };
  }

  /** 校验：所有单词确实按顺序出现在矩阵中 */
  function verifyPuzzle(grid, placed, words) {
    for (let i = 0; i < words.length; i++) {
      const w = words[i];
      const p = placed[w];
      if (!p) return false;
      let str = '';
      for (let k = 0; k < p.cells.length; k++) {
        const rc = p.cells[k];
        str += grid[rc[0]][rc[1]];
      }
      if (str !== w) return false;
    }
    return true;
  }

  function generatePuzzle(words) {
    // 长词优先，降低互相阻挡的概率
    const sorted = words.slice().sort((a, b) => b.length - a.length);

    for (let attempt = 0; attempt < 400; attempt++) {
      const grid = [];
      for (let r = 0; r < SIZE; r++) {
        grid.push(new Array(SIZE).fill(''));
      }
      const placed = {};
      let ok = true;

      for (let i = 0; i < sorted.length; i++) {
        const w = sorted[i];
        const pos = placeWord(grid, w);
        if (!pos) { ok = false; break; }
        placed[w] = pos;
      }
      if (!ok) continue;

      // 空白填充随机字母
      for (let r = 0; r < SIZE; r++) {
        for (let c = 0; c < SIZE; c++) {
          if (!grid[r][c]) grid[r][c] = randLetter();
        }
      }

      // 最终校验
      if (!verifyPuzzle(grid, placed, words)) continue;

      return { grid: grid, placed: placed };
    }
    return null;
  }

  /* ============================================================
     7. 单词解析
     ============================================================ */
  function parseWords(raw) {
    const out = [];
    const seen = new Set();
    let bad = 0;

    const parts = String(raw || '').trim().split(/[\s,，、;；]+/).filter(Boolean);
    for (let i = 0; i < parts.length; i++) {
      const w = parts[i].toLowerCase().replace(/[^a-z]/g, '');
      if (w.length < 2 || w.length > SIZE) { bad++; continue; }
      if (seen.has(w)) continue;
      seen.add(w);
      out.push(w);
    }

    let trimmed = 0;
    if (out.length > 10) { trimmed = out.length - 10; out.length = 10; }

    return { words: out, bad: bad, trimmed: trimmed };
  }

  function pickRandomWords() {
    const n = 5 + Math.floor(Math.random() * 6); // 5 ~ 10
    const pool = WORD_POOL.slice();
    for (let i = pool.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      const t = pool[i]; pool[i] = pool[j]; pool[j] = t;
    }
    return pool.slice(0, n);
  }

  /* ============================================================
     8. 渲染
     ============================================================ */
  function renderBoard() {
    const frag = document.createDocumentFragment();
    for (let r = 0; r < SIZE; r++) {
      for (let c = 0; c < SIZE; c++) {
        const d = document.createElement('div');
        d.className = 'cell';
        d.dataset.r = r;
        d.dataset.c = c;
        d.textContent = state.grid[r][c] || '';
        frag.appendChild(d);
      }
    }
    boardEl.innerHTML = '';
    boardEl.appendChild(frag);
  }

  function renderDecorationBoard() {
    const grid = [];
    for (let r = 0; r < SIZE; r++) {
      const row = [];
      for (let c = 0; c < SIZE; c++) row.push(randLetter());
      grid.push(row);
    }
    state.grid = grid;
    renderBoard();
    // 装饰棋盘降低不透明度
    boardEl.style.opacity = '0.35';
  }

  function renderWords() {
    wordListEl.innerHTML = '';
    state.words.forEach(function (w, i) {
      const chip = document.createElement('span');
      chip.className = 'word-chip';
      chip.dataset.word = w;
      chip.textContent = w;
      chip.style.setProperty('--c', state.colors[w] || COLORS[i % COLORS.length]);
      chip.style.animationDelay = (i * 45) + 'ms';
      wordListEl.appendChild(chip);
    });
  }

  function updateHUD() {
    const foundCount = state.found.filter(Boolean).length;
    timerVal.textContent = fmtTime(state.elapsed / 1000);
    progressVal.textContent = foundCount + '/' + state.words.length;

    if (state.timeLimit > 0) {
      const remaining = Math.max(0, state.timeLimit - state.elapsed);
      remainVal.textContent = fmtTime(remaining / 1000);
      remainItem.classList.toggle('warn', state.running && remaining <= 10000);
    } else {
      remainVal.textContent = '--:--';
      remainItem.classList.remove('warn');
    }
  }

  /* ============================================================
 9. 选择交互
     ============================================================ */
  function clearSelHighlight() {
    const list = boardEl.querySelectorAll('.cell.sel');
    for (let i = 0; i < list.length; i++) list[i].classList.remove('sel');
  }

  function setSelection(cells) {
    clearSelHighlight();
    for (let i = 0; i < cells.length; i++) {
      const el = cellAt(cells[i].r, cells[i].c);
      if (el) el.classList.add('sel');
    }
    state.selCells = cells;
  }

  function onPointerDown(e) {
    if (!state.running || state.selStart) return;
    const cell = e.target.closest ? e.target.closest('.cell') : null;
    if (!cell) return;
    if (e.pointerType === 'mouse' && e.button !== 0) return;

    e.preventDefault();
    state.activePointer = e.pointerId;
    try { boardEl.setPointerCapture(e.pointerId); } catch (_) {}

    state.selStart = { r: +cell.dataset.r, c: +cell.dataset.c };
    setSelection([state.selStart]);
    GameAudio.click();
  }

  function onPointerMove(e) {
    if (!state.running || !state.selStart) return;
    if (state.activePointer !== null && e.pointerId !== state.activePointer) return;

    const el = document.elementFromPoint(e.clientX, e.clientY);
    if (!el || !el.closest) return;
    const cell = el.closest('.cell');
    if (!cell || cell.parentElement !== boardEl) return;

    const r = +cell.dataset.r;
    const c = +cell.dataset.c;
    const sr = state.selStart.r;
    const sc = state.selStart.c;

    let cells = null;
    if (r === sr) {
      const a = Math.min(c, sc), b = Math.max(c, sc);
      cells = [];
      for (let i = a; i <= b; i++) cells.push({ r: sr, c: i });
    } else if (c === sc) {
      const a = Math.min(r, sr), b = Math.max(r, sr);
      cells = [];
      for (let i = a; i <= b; i++) cells.push({ r: i, c: sc });
    }
    if (cells) setSelection(cells);
  }

  function onPointerUp(e) {
    if (!state.selStart) return;
    if (state.activePointer !== null && e && e.pointerId !== state.activePointer) return;

    const cells = state.selCells.slice();
    state.selStart = null;
    state.selCells = [];
    state.activePointer = null;
    clearSelHighlight();

    if (cells.length < 2) return;
    checkWord(cells);
  }

  /* ============================================================
     10. 判定
     ============================================================ */
  function checkWord(cells) {
    let str = '';
    for (let i = 0; i < cells.length; i++) {
      str += state.grid[cells[i].r][cells[i].c];
    }
    const rev = str.split('').reverse().join('');

    let idx = -1;
    for (let i = 0; i < state.words.length; i++) {
      if (state.found[i]) continue;
      if (state.words[i] === str || state.words[i] === rev) { idx = i; break; }
    }

    if (idx === -1) {
      GameAudio.fail();
      return;
    }

    const word = state.words[idx];
    const color = state.colors[word];

    state.found[idx] = true;

    for (let i = 0; i < cells.length; i++) {
      const el = cellAt(cells[i].r, cells[i].c);
      if (!el) continue;
      el.classList.add('found');
      el.style.background = color;
      el.style.color = '#fff';
      el.style.boxShadow = '0 4px 12px -4px ' + color;
    }

    const chip = wordListEl.querySelector('.word-chip[data-word="' + word + '"]');
    if (chip) chip.classList.add('found');

    GameAudio.match();
    updateHUD();

    // 全部找到
    const allFound = state.found.every(Boolean);
    if (allFound) {
      state.elapsed = performance.now() - state.startTime;
      state.running = false;
      clearInterval(state.timerId);
      GameAudio.stopMusic();
      updateHUD();
      setTimeout(function () { showEnd(true); }, 520);
    }
  }

  /* ============================================================
     11. 计时
     ============================================================ */
  function startTimer() {
    clearInterval(state.timerId);
    state.timerId = setInterval(function () {
      if (!state.running) return;

      state.elapsed = performance.now() - state.startTime;
      updateHUD();

      const remaining = state.timeLimit - state.elapsed;

      if (remaining <= 0) {
        // 时间耗尽
        state.elapsed = state.timeLimit;
        state.running = false;
        clearInterval(state.timerId);
        GameAudio.stopMusic();
        updateHUD();
        showEnd(false);
        return;
      }

      if
